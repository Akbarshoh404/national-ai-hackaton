# --- core ---
DATABASE_URL=sqlite:///./bozorpilot.db
ADMIN_KEY=change-me
CORS_ORIGINS=http://localhost:3000,https://bozorpilot.vercel.app
DEMO_MODE=true
AUTO_MIGRATE=true
LOG_LEVEL=INFO

# --- workers (one process runs everything) ---
WORKERS_TELEGRAM=true
WORKERS_EXTRACTOR=true
WORKERS_DECISIONS=true
BOT_ENABLED=true

# --- Telegram user client (read-only) — https://my.telegram.org ---
TG_API_ID=
TG_API_HASH=
# StringSession printed by `python -m app.cli tg-login` (servers). Locally a session file is used instead.
TG_SESSION=
TG_HISTORY_LIMIT=3000

# --- Telegram bot — @BotFather ---
TG_BOT_TOKEN=

# --- LLM (optional: every feature has a deterministic fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- market ---
USD_UZS=12700
MARKET_WINDOW_DAYS=60
MIN_COMPARABLES=5
DEAL_THRESHOLD=0.15
SLOW_STOCK_DAYS=60

# --- finance (VERIFY before showing to real users) ---
TURNOVER_TAX_RATE=0.04
VAT_RATE=0.12
PROFIT_TAX_RATE=0.15
DEFAULT_LOAN_RATE=24
MAX_DEBT_SERVICE_RATIO=0.5
